---
source: crates/dexo-mcp/tests/protocol.rs
expression: client.tools().await
---
[
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Cancel the running query of one server session. Appears while a person has let this profile end sessions on this connection; each call waits for their approval unless they let it run without asking.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confirm_target": {
          "description": "Required to terminate a session: repeat `session_id` exactly to confirm.",
          "type": [
            "string",
            "null"
          ]
        },
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Unique id for this action. Retrying with the same id and payload returns the first result.",
          "type": "string"
        },
        "session_id": {
          "description": "Server session to act on, from `admin_list_sessions`, listed while this profile may end sessions.",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "session_id"
      ],
      "type": "object"
    },
    "name": "admin_cancel_query"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Server sessions: id, user, database, state and duration. Query text is not returned. Listed only when the profile allows it explicitly.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "admin_list_sessions"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false
    },
    "description": "Terminate one server session. Appears while a person has let this profile end sessions on this connection; each call waits for their approval unless they let it run without asking, and needs `confirm_target` equal to `session_id`.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confirm_target": {
          "description": "Required to terminate a session: repeat `session_id` exactly to confirm.",
          "type": [
            "string",
            "null"
          ]
        },
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Unique id for this action. Retrying with the same id and payload returns the first result.",
          "type": "string"
        },
        "session_id": {
          "description": "Server session to act on, from `admin_list_sessions`, listed while this profile may end sessions.",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "session_id"
      ],
      "type": "object"
    },
    "name": "admin_terminate_session"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Children of a catalog node, live from the server: databases, then schemas, then tables and views, then columns and indexes. Omit `parent_id` for the roots. Objects outside the allowlist are not listed.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "description": "`id` of the node whose children to list, from an earlier catalog_list; omit for the roots.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "catalog_list"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Tables, views, columns, indexes and constraints by name, or by what their notes say, in the connection's indexed catalog. The first search on a connection indexes it, which can take a while on a large server.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "At most this many hits (default 50, at most 200).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "description": "Part of a table, view or column name.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "catalog_search"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false
    },
    "description": "Delete the one row named by `identity`. Appears while a person has let this profile change rows; each call waits for their approval unless they let it run without asking.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "additionalProperties": true,
          "description": "Primary-key (or unique) column to value, naming exactly one row.",
          "type": "object"
        },
        "operation_id": {
          "description": "Unique id for this change. Retrying with the same id and payload returns the first result instead of writing twice.",
          "type": "string"
        },
        "target": {
          "description": "Table to write, e.g. `public.orders`.",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "target",
        "identity"
      ],
      "type": "object"
    },
    "name": "data_delete"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false
    },
    "description": "Run a script of INSERT, UPDATE, DELETE or (on Postgres) TRUNCATE statements as one transaction -- a whole seed in one call, all of it or none of it. Appears while a person has let this profile change rows; every table it touches must be one the profile sees, and the call waits for one approval of the whole script, unless they let all of it run without asking.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "description": "A .sql file to run instead of `sql`, by its path inside the project folder the server was started in, at most 1 MiB. It is read once: what is approved is what runs.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Unique id for this change. Retrying with the same id and payload returns the first result instead of writing twice.",
          "type": "string"
        },
        "sql": {
          "description": "One or more INSERT, UPDATE, DELETE or (on Postgres) TRUNCATE statements separated by `;`, run as one transaction: all of them, or none if one fails. One approval covers the whole script. Pass this or `file`.",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "What the audit names this change by; the tables it touches when left out. Every table the SQL touches must be one the profile sees.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "operation_id"
      ],
      "type": "object"
    },
    "name": "data_execute_sql"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Insert one row. Appears while a person has let this profile change rows on a connection; each call waits for their approval on Dexo's Agents screen, unless they let it run without asking.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Unique id for this change. Retrying with the same id and payload returns the first result instead of writing twice.",
          "type": "string"
        },
        "target": {
          "description": "Table to write, e.g. `public.orders`; a bare name uses the connection's default database and schema.",
          "type": "string"
        },
        "values": {
          "additionalProperties": true,
          "description": "Column name to value for the new row.",
          "type": "object"
        }
      },
      "required": [
        "operation_id",
        "target",
        "values"
      ],
      "type": "object"
    },
    "name": "data_insert"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "One page of a table or view, without writing SQL. Works in structured-only profiles. Follow `next_offset` for the next page.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Rows per page (default 100, capped by the profile's max_rows).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "description": "Row offset of the page (default 0); use the `next_offset` of the previous page.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "table": {
          "description": "Table or view to read, qualified like object_describe.",
          "type": "string"
        }
      },
      "required": [
        "table"
      ],
      "type": "object"
    },
    "name": "data_read"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false
    },
    "description": "Update the one row named by `identity`. Appears while a person has let this profile change rows; each call waits for their approval unless they let it run without asking.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "additionalProperties": true,
          "description": "Primary-key (or unique) column to value, naming exactly one row.",
          "type": "object"
        },
        "operation_id": {
          "description": "Unique id for this change. Retrying with the same id and payload returns the first result instead of writing twice.",
          "type": "string"
        },
        "target": {
          "description": "Table to write, e.g. `public.orders`.",
          "type": "string"
        },
        "values": {
          "additionalProperties": true,
          "description": "Column name to new value.",
          "type": "object"
        }
      },
      "required": [
        "operation_id",
        "target",
        "identity",
        "values"
      ],
      "type": "object"
    },
    "name": "data_update"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "The saved connections this profile may use: driver, database, environment, and whether writes are possible at all. Pass a name as `connection` to the other tools.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "name": "list_connections"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Columns (with type and key role) of one table or view.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Qualified name such as `public.orders` or `db.public.orders`; a bare name uses the connection's default database and schema.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "object_describe"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "The CREATE statement of one object, as the server reports it.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Qualified name such as `public.orders` or `db.public.orders`; a bare name uses the connection's default database and schema.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "object_get_ddl"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Objects this one depends on and objects that depend on it, limited to what the allowlist shows.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Qualified name such as `public.orders` or `db.public.orders`; a bare name uses the connection's default database and schema.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "object_relationships"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Run one read-only statement inside a read-only transaction and return the rows as a table. Every table it names must be inside the profile's allowlist.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "sql": {
          "description": "One read-only statement: SELECT, WITH … SELECT, VALUES, TABLE, or EXPLAIN without ANALYZE.",
          "type": "string"
        }
      },
      "required": [
        "sql"
      ],
      "type": "object"
    },
    "name": "query_execute_read"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Estimated plan for one read-only statement. Runs EXPLAIN without ANALYZE, so nothing is executed. `hypothetical_indexes` plans as if those indexes were built (Postgres with hypopg), to see whether one would help before anyone builds it.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "hypothetical_indexes": {
          "default": [],
          "description": "Indexes to plan with as if they were built, without building them -- each one\n`CREATE INDEX ON table (columns)`. Postgres with the hypopg extension only; they\nexist for this plan alone.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sql": {
          "description": "One read-only statement: SELECT, WITH … SELECT, VALUES or TABLE.",
          "type": "string"
        }
      },
      "required": [
        "sql"
      ],
      "type": "object"
    },
    "name": "query_explain"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Check whether query_execute_read would accept a statement, without running it. Says why when it would not.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "sql": {
          "description": "One read-only statement: SELECT, WITH … SELECT, VALUES, TABLE, or EXPLAIN without ANALYZE.",
          "type": "string"
        }
      },
      "required": [
        "sql"
      ],
      "type": "object"
    },
    "name": "query_validate"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false
    },
    "description": "Apply one DDL statement. Appears while a person has let this profile change the schema; each call waits for their approval unless they let it run without asking. Destructive DDL needs `confirm_target` equal to `target`. MySQL commits DDL implicitly.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confirm_target": {
          "description": "Required for destructive DDL: repeat `target` exactly to confirm.",
          "type": [
            "string",
            "null"
          ]
        },
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Unique id for this change. Retrying with the same id and payload returns the first result instead of writing twice.",
          "type": "string"
        },
        "sql": {
          "description": "One CREATE TABLE, ALTER TABLE, DROP, CREATE INDEX or CREATE VIEW.",
          "type": "string"
        },
        "target": {
          "description": "The object the grant was issued for.",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "target",
        "sql"
      ],
      "type": "object"
    },
    "name": "schema_apply_ddl"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Differences between two saved schema snapshots, limited to objects this profile may see. Read-only: nothing is applied.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection the snapshots were taken of; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "from_snapshot": {
          "description": "Name of the older snapshot, saved with `dexo schema snapshot --connection C --name N`.",
          "type": "string"
        },
        "to_snapshot": {
          "description": "Name of the newer snapshot.",
          "type": "string"
        }
      },
      "required": [
        "from_snapshot",
        "to_snapshot"
      ],
      "type": "object"
    },
    "name": "schema_diff"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Every table and view of a schema the profile sees, in one call: columns with type, nullability and default, primary and unique keys, foreign keys and checks, and the row count the server estimates -- or counts, with `exact_counts`. Use it instead of object_describe table by table.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "connection": {
          "description": "Connection name from `list_connections`; optional when the profile has exactly one.",
          "type": [
            "string",
            "null"
          ]
        },
        "exact_counts": {
          "description": "Count each table's rows with count(*) instead of the server's estimate: exact, but it reads every row, 200 tables at most.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "schema": {
          "description": "The schema to describe (on MySQL, the database); every one the profile sees when left out.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "schema_overview"
  }
]
